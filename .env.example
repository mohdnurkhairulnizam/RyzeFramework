# Core hosted runtime
NODE_ENV=development
DATABASE_URL=mysql://user:password@localhost/ryze
JWT_SECRET=replace-with-a-local-secret
OWNER_OPEN_ID=
VITE_APP_ID=
OAUTH_SERVER_URL=

# Managed object storage (required for uploads/generated files in hosted mode)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Blueprint integrations intentionally remain disabled until separately designed,
# reviewed and tested. Do not add secrets to this file.
RYZE_PROVIDER=local-demo
RYZE_MODEL=ryze-safe-demo
NERD_MODEL=nerd-safe-demo
RYZE_EXTERNAL_LLM_ENABLED=false
RYZE_TELEGRAM_ENABLED=false
# Future local worker only; keep API credentials and .session files off the dashboard
RYZE_TELEGRAM_TRANSPORT=user-account-worker
RYZE_TELEGRAM_SESSION_ROOT=
# Local worker setting; list approved Telegram chat IDs, comma-separated.
TELEGRAM_ALLOWED_CHAT_IDS=
RYZE_EMAIL_ENABLED=false

# Hosted worker API. Use a generated high-entropy value; never commit it.
RYZE_WORKER_TOKEN=
RYZE_WORKER_OWNER_OPEN_ID=

# Future Stage 2–4 settings are deliberately unspecified in the origin blueprint:
# memory platform, watchdog policy, portable runtime, encryption, Drive exchange,
# conflict resolution and Master/Slave restrictions.
