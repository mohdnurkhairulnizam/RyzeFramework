# Standalone local build reference only. Do not copy this file to .env.
# Install-Ryze.cmd generates a protected .env with random secret material and
# a salted owner-password hash. Never commit or share that generated file.
NODE_ENV=production
RYZE_LOCAL_MODE=true
PORT=3777

# Installer-generated locations; these are local to the current Windows user.
RYZE_DATA_DIR=<generated-by-installer>
RYZE_DATABASE_PATH=<generated-by-installer>
RYZE_STORAGE_DIR=<generated-by-installer>

# Generated locally during installation; no safe placeholder/default exists.
JWT_SECRET=<generated-by-installer>
RYZE_LOCAL_OWNER_OPEN_ID=ryze-local-owner
RYZE_LOCAL_OWNER_NAME=Local Owner
RYZE_LOCAL_PASSWORD_SALT=<generated-by-installer>
RYZE_LOCAL_PASSWORD_HASH=<generated-by-installer>

# OpenCode/FreeLLMAPI, email, and Telegram integrations are not configured by
# the starter ZIP. Do not add credentials until the integration is implemented,
# reviewed, and explicitly configured by the owner.
